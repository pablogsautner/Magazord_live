# Magazord
MAGAZORD_BASE_URL=https://feiraodetoalhas.painel.magazord.com.br/api
MAGAZORD_USER=
# use aspas se a senha tiver #, pois o dotenv corta o valor ali se não estiver entre aspas
MAGAZORD_PASSWORD=
MAGAZORD_TABELA_PRECO_ID=1
MAGAZORD_LOJA_ID=1
MAGAZORD_STOREFRONT_URL=https://sualoja.com.br

# Supabase (usar a service_role key aqui, NUNCA no frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Servidor
PORT=3333

# Chave simétrica usada pra criptografar a senha da Magazord de cada empresa
# antes de salvar no banco. Gere a sua com: openssl rand -hex 32
# (ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Trocar essa chave depois de já ter empresas cadastradas invalida os dados salvos.
ENCRYPTION_KEY=

# Emails que podem acessar o painel interno (/empresas, /usuarios, /membros).
# Precisam já existir como usuário no Supabase Auth. Separe por vírgula.
SUPER_ADMIN_EMAILS=voce@suaempresa.com

# Servidor de live próprio (SRS + auth/hooks, repo sereniia-org/test-live-server).
# STREAM_SIGNING_SECRET precisa ser EXATAMENTE igual à do serviço de auth na
# VPS (é o que faz o token que a gente emite ser validado lá). Gere com:
# openssl rand -hex 32
STREAM_SIGNING_SECRET=
# URL do serviço de auth do servidor de live, acessível por este backend
# (server-to-server, ex: http://<vps-ip-ou-host>:9000)
STREAM_AUTH_SERVICE_URL=
# URL pública que o navegador do vendedor usa pra publicar (WHIP), atrás do
# Caddy/TLS (ex: https://live.suaempresa.com.br)
STREAM_SERVER_PUBLIC_URL=
# URL RTMP pra quem transmite pelo OBS (ex: rtmp://live.suaempresa.com.br/live)
STREAM_SERVER_RTMP_URL=
